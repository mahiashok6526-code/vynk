# Vynk Backend Configuration

PROJECT_NAME=Vynk API
ENV=development
API_V1_STR=/api/v1

# Security
# Generate with: openssl rand -hex 32
SECRET_KEY=vynk_super_secret_jwt_key_change_in_production_32chars!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Phase 1 local development default:
DATABASE_URL=sqlite+aiosqlite:///./vynk.db

# Production / PostgreSQL target configuration:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vynk

# CORS Configuration (JSON array of strings)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# AI Service Configuration (Pluggable architecture - Planned for Phase 2)
AI_PROVIDER=gemini
GEMINI_API_KEY=
