# ==============================================================================
# Vynk Backend Environment Configuration Template
# Copy this file to .env and configure appropriate values for your environment.
# DO NOT COMMIT REAL SECRETS OR PRODUCTION PASSWORDS TO VERSION CONTROL.
# ==============================================================================

# Application Settings
PROJECT_NAME="Vynk API"
VERSION=1.0.0
ENV=development # development | test | production
DEBUG=false
API_V1_STR=/api/v1

# Security & JWT Configuration
# In production, SECRET_KEY must be a strong random string (at least 32 characters).
# Generate with: openssl rand -hex 32
SECRET_KEY=replace_with_a_secure_random_secret_at_least_32_characters_long!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local Development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./vynk.db

# Production (PostgreSQL with asyncpg):
# DATABASE_URL=postgresql+asyncpg://vynk_user:vynk_secure_password@localhost:5432/vynk_db

# Connection Pool Settings (PostgreSQL only)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# CORS Configuration (JSON array of allowed origins)
# In production, specify your exact domain(s); wildcards ('*') are strictly rejected.
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# AI Compatibility Service Configuration (Optional)
# If GEMINI_API_KEY is not provided, Vynk automatically falls back to deterministic compatibility scoring.
AI_PROVIDER=gemini
GEMINI_API_KEY=
