# ==============================================================================
# Vynk Full-Stack Deployment Environment Configuration Template
# ==============================================================================

# Backend Environment
ENV=production
PROJECT_NAME="Vynk API"
VERSION=1.0.0
API_V1_STR=/api/v1
SECRET_KEY=replace_with_a_secure_random_secret_at_least_32_characters_long!
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Production Database Configuration
POSTGRES_USER=vynk_user
POSTGRES_PASSWORD=replace_with_secure_db_password
POSTGRES_DB=vynk_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://vynk_user:replace_with_secure_db_password@db:5432/vynk_db

# Frontend Domain & CORS Configuration
BACKEND_CORS_ORIGINS=["https://vynk.yourdomain.com"]
VITE_API_BASE_URL=https://api.vynk.yourdomain.com/api/v1

# Optional AI Key
GEMINI_API_KEY=
